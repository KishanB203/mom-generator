<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": signs MoMGenerator.exe (uploaded by release.yml as a zip) -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="MoMGenerator.exe" product-name="MoM Generator" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
